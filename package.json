{
  "name": "@hoshinotatsuya/net-guard",
  "version": "0.7.2",
  "description": "SSRF protection for Node.js: decides whether an outbound destination is public (IPv4/IPv6 in every form, embedded IPv4, internal zones, cloud metadata) and enforces it in http/https agents, undici, fetch, axios, got, http2 and CONNECT proxies.",
  "keywords": [
    "ssrf",
    "security",
    "dns",
    "ip",
    "ipv6",
    "undici",
    "fetch",
    "http-agent",
    "axios",
    "got",
    "http2",
    "proxy",
    "dns-rebinding"
  ],
  "license": "MIT",
  "author": "Hoshino_Tatsuya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HoshinoTatsuya/net-guard.git"
  },
  "homepage": "https://github.com/HoshinoTatsuya/net-guard#readme",
  "bugs": {
    "url": "https://github.com/HoshinoTatsuya/net-guard/issues"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json",
    "lint": "biome check src examples",
    "test": "jest-groups --out .jest-report.json -- node_modules/.bin/jest && jest-assert-no-skipped .jest-report.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run test:consumers && pnpm run build",
    "bench:dns": "sh scripts/bench-dns-docker.sh",
    "test:consumers": "scripts/consumer-matrix.sh"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "undici": "^7.10.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@hoshinotatsuya/arch-gates": "^0.12.2",
    "@hoshinotatsuya/jest-groups": "^0.7.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.0.15",
    "jest": "30.5.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.5",
    "typescript": "5.9.3",
    "undici": "7.10.0"
  }
}
